# Copy to .env for local use, or set these as secrets on your host.
NODE_ENV=production
PORT=8080
# Public URL, used in emails, Stripe redirects and the CSRF origin check.
BASE_URL=https://jsondiff.example.com
# 32+ random characters. Encrypts saved headers and webhook URLs; never change it after launch.
# Generate: openssl rand -base64 32
APP_SECRET=
DATABASE_PATH=/data/app.db
# Set to true behind Fly.io, Render or another proxy so rate limits see real client IPs.
TRUST_PROXY=true

# Email (https://resend.com). Without it, sign-in links and alerts are printed to the log.
RESEND_API_KEY=
EMAIL_FROM=JSON Diff Studio <alerts@jsondiff.example.com>

# Stripe (https://dashboard.stripe.com/apikeys). Billing buttons stay hidden until all four are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_TEAM=
